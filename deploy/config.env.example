# Copy this file to deploy/config.env and fill in the four required values.
#
#   cp deploy/config.env.example deploy/config.env
#
# deploy/config.env is gitignored - it holds secrets and must never be committed.

# ---- Required ----------------------------------------------------------

# Your Google Cloud project ID.
GOOGLE_PROJECT_ID=asaya-data-room-487110

# Google Ads developer token, from Google Ads -> Tools -> API Center.
# Needs Explorer access (or higher) to read production accounts.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth 2.0 client of type "Web application", created in the project above at
# Cloud Console -> APIs & Services -> Credentials.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=

# ---- Optional ----------------------------------------------------------

# Only needed if you reach the ads account through a manager (MCC) account.
# Set it to the MANAGER's customer ID, digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Deployment knobs. The defaults are fine.
REGION=us-central1
SERVICE=google-ads-mcp
AR_REPO=mcp-servers

# GOOGLE_ADS_MCP_JWT_SIGNING_KEY is generated and appended automatically by
# deploy/cloudrun.sh on the first run. Leave it alone after that.
