{
  "brand": "Asaya",
  "timezone": "Asia/Kolkata",
  "currency": "INR",

  "gcp": {
    "project": "asaya-data-room-487110",
    "bq_location": "asia-south1",
    "dataset": "asaya-data-room-487110.Maplemonk"
  },

  "tabs": [
    {"id": "overview",  "label": "Overview",  "phase": 1, "enabled": true},
    {"id": "live",      "label": "Today",     "phase": 1, "enabled": true},
    {"id": "daily",     "label": "Daily",     "phase": 1, "enabled": true},
    {"id": "marketing", "label": "Marketing", "phase": 1, "enabled": true},
    {"id": "products",  "label": "Products",  "phase": 1, "enabled": true},
    {"id": "d1",        "label": "D-1",       "phase": 1, "enabled": true},
    {"id": "retention", "label": "Retention", "phase": 1, "enabled": true},
    {"id": "health",    "label": "Data health", "phase": 1, "enabled": true},
    {"id": "traffic",   "label": "Traffic",   "phase": 2, "enabled": false},
    {"id": "webapp",    "label": "Web & App", "phase": 2, "enabled": false},
    {"id": "calendar",  "label": "Calendar",  "phase": 2, "enabled": false},
    {"id": "monthly",   "label": "Monthly",   "phase": 2, "enabled": false},
    {"id": "search",    "label": "Search",    "phase": 2, "enabled": false},
    {"id": "cohorts",   "label": "Cohorts",   "phase": 3, "enabled": false},
    {"id": "inventory", "label": "Inventory", "phase": null, "enabled": false, "note": "Ignored for now: no inventory history source."}
  ],

  "refresh": {
    "first_run": "07:00",
    "bq_ready_by": "06:30",
    "alert_from": "10:00",
    "retry_minutes": 30,
    "history_days": 400,
    "backfill_days_per_run": 40,
    "refetch_recent_days": 3,
    "reconcile": {
      "orders":       {"pct": 0.01,  "min_abs": 3,  "block": true},
      "meta_spend":   {"pct": 0.005, "min_abs": 50, "block": false},
      "google_spend": {"pct": 0.005, "min_abs": 50, "block": false}
    },
    "required_sources": ["shopify_orders", "shopify_order_items", "gokwik_funnel", "gokwik_orders", "google_ads", "shopify_sessions"]
  },

  "live": {
    "typical_weeks": 8,
    "typical_days": 4,
    "min_typical_days": 2,
    "refresh_seconds": 180,
    "stale_minutes": {"shopify": 20, "ads": 60, "gokwik": 90}
  },

  "manual_spends": {
    "note": "Spends that have no API, read from the team's Google Sheets on every refresh. Sheet ids come from the SPEND_SHEET_* environment variables (see deploy.env.example); the sheets are shared with the dashboard's service account as Viewer.",
    "sources": {
      "affiliate": {
        "label": "Affiliate",
        "sheet_env": "SPEND_SHEET_AFFILIATE",
        "tab": "Daily - report",
        "header_row": 2,
        "date_col": "B",
        "date_format": "%Y-%m-%d",
        "columns": {"spend": "F", "revenue": "E"}
      },
      "crm_flow": {
        "label": "CRM flow",
        "sheet_env": "SPEND_SHEET_CRM_FLOW",
        "tab": "Daily Flow Spends",
        "header_row": 2,
        "date_col": "A",
        "date_format": "%d/%m/%Y",
        "columns": {"spend": "F", "revenue": "G"}
      },
      "crm_broadcast": {
        "label": "CRM broadcast",
        "sheet_env": "SPEND_SHEET_CRM_BROADCAST",
        "tab": "Broadcast Daily Spends",
        "header_row": 1,
        "date_col": "A",
        "date_format": "%b %d",
        "start_year": 2026,
        "columns": {"spend": "B", "revenue": "C"},
        "filled_through_follows": "crm_flow"
      }
    },
    "live_estimate": {
      "affiliate": "per_gmv",
      "crm": "per_hour",
      "basis_days": 7
    }
  },

  "pulse": {
    "baseline_days": 28,
    "min_baseline_days": 5,
    "watch_z": 3,
    "problem_z": 4,
    "watch_drop": 0.12,
    "problem_drop": 0.20
  },

  "retention": {
    "dedupe_hours": 24
  },

  "orders": {
    "exclude_name_regex": "ASAYASS|ASAYAINF"
  },

  "freebies": {
    "exclude_product_types": ["freebie", "merch", "book", "gummies", ""],
    "known_types": ["serum", "treatment", "combo", "sunscreen", "moisturiser", "moisturise", "cleanser", "gel", "scrub", "hand cream"]
  },

  "sessions": {
    "awareness_name_regex": "awareness",
    "google_sources": ["google", "youtube"],
    "breakdown_limit": 10000,
    "landing_page_limit": 300
  },

  "meta": {
    "graph_api_version": "v24.0",
    "lookback_days": 7,
    "accounts": {
      "act_666565859450360": "Asaya Sales",
      "act_1040064540569018": "Asaya Top Funnel"
    },
    "purchase_action_types": ["omni_purchase", "offsite_conversion.fb_pixel_purchase", "purchase"],
    "token_secret": "meta-system-user-token"
  },

  "google_ads": {
    "account_id": "6548153452",
    "login_customer_id": "2013716241",
    "api_version": "v23",
    "client_id_secret": "google-ads-client-id",
    "client_secret_secret": "google-ads-client-secret",
    "refresh_token_secret": "google-ads-refresh-token",
    "zero_spend_dates": {
      "2026-10-07": "No budget in the Google Ads account that day, so spend was zero"
    }
  },

  "shopify": {
    "store": "b1d470.myshopify.com",
    "api_version": "2026-10",
    "client_id_secret": "shopify-client-id",
    "client_secret_secret": "shopify-client-secret"
  },

  "channels": [
    {"channel": "No UTM (direct / organic)", "match": {"utm_source": "^(|direct|\\(direct\\)|none|na)$"}},
    {"channel": "Organic Search", "match": {"utm_source": "^google$", "utm_medium": "^(product_sync|organic|)$"}},
    {"channel": "Meta Ads",       "match": {"utm_source": "^(facebook|fb|ig|instagram|meta)$", "utm_medium": "^(cpc|paid|paid_social|ppc)$"}},
    {"channel": "Google Ads",     "match": {"utm_source": "^(google|youtube|yt)$", "utm_medium": "^(cpc|ppc|paid)$"}},
    {"channel": "Reddit Ads",     "match": {"utm_source": "^reddit$"}},
    {"channel": "Affiliate",      "match": {"utm_source": "^(affiliate|cashkaro|wishlink|togethr|paytm|sangria_blogs|sangria|analyticsclouds|xpl|smytten|fkm|mma|criteo)$"}},
    {"channel": "Affiliate",      "match": {"utm_medium": "^(affiliate|cps|coupon|wishlink\\.com|sangria)$"}},
    {"channel": "CRM",            "match": {"utm_source": "^(kwikengage|kwe|whatsapp|wa|email|klaviyo|bik|bitespeed|nector|verifast|strongmetrics)$"}},
    {"channel": "CRM",            "match": {"utm_medium": "^(wa|whatsapp|email|sms|automation|crm)$"}},
    {"channel": "Organic Social", "match": {"utm_source": "^(ig|instagram|facebook|fb|igshopping)$"}},
    {"channel": "AI Assistants",  "match": {"utm_source": "^(chatgpt\\.com|perplexity|gemini)$"}}
  ],

  "phases": {
    "hourly": {
      "shape_quantile": 0.35,
      "level_quantile": 0.3,
      "level_window_days": 21,
      "on_ratio": 2.2,
      "off_ratio": 1.5,
      "min_days": 45,
      "min_hours": 30,
      "min_mean_ratio": 1.8,
      "merge_gap_hours": 6,
      "full_day_share": 0.85,
      "bau_max_share": 0.1
    },
    "baseline_days": 28,
    "sale_ratio": 1.6,
    "grey_ratio": 1.3,
    "spend_ratio": 1.3,
    "shoulder_days": 2,
    "overrides": {}
  },

  "d1": {
    "max_window_days": 7,
    "min_days_between_sales": 20,
    "window_overrides": null,
    "drilldown_rows": 15
  },

  "commentary": {
    "enabled": true,
    "model": "claude-opus-5-5",
    "effort": "high",
    "api_key_secret": "anthropic-api-key"
  }
}
