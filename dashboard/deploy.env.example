# Copy to dashboard/deploy.env and fill in. deploy.env is gitignored.
#
#   cp dashboard/deploy.env.example dashboard/deploy.env

# ---- Required ----------------------------------------------------------

GOOGLE_PROJECT_ID=asaya-data-room-487110

# OAuth client of type "Web application" for Google sign-in. Its
# "Authorized JavaScript origins" must include the dashboard URL that
# deploy.sh prints (add it after the first deploy, then redeploy).
GOOGLE_OAUTH_CLIENT_ID=

# First person on the allowlist (more with `python -m app.allowlist add`).
FIRST_ALLOWED_EMAIL=

# ---- Optional ----------------------------------------------------------

# Email for "data still missing at 10:00 IST" alerts (Cloud Monitoring).
ALERT_EMAIL=

# Chat webhook (e.g. Google Chat) that also receives alerts.
ALERT_WEBHOOK_URL=

# Same region as the BigQuery data.
REGION=asia-south1
SERVICE=asaya-d2c-dashboard
JOB=asaya-d2c-refresh
AR_REPO=dashboards
