{
  "_about": "How Shopify order lines become retention products. Titles are lower-cased, non-ASCII characters become spaces and runs of spaces collapse before any pattern is tried. Patterns use only the regex features Python and BigQuery (RE2) share, so the same rules can be run in SQL to check coverage. Order matters: the first matching rule wins. Edit here, rebuild, and the Catalogue coverage panel on the Retention tab shows what changed.",

  "count_minis": false,

  "exclude_always": [
    {"reason": "gift line", "pattern": "gift|gifting|\\bfree\\b|^_|^test|pay remaining amount"},
    {"reason": "mini or trial size", "pattern": "\\bmini\\b|\\bminis\\b|little luxuries"},
    {"reason": "travel kit", "pattern": "\\btravel\\b"}
  ],

  "exclude_unless_product": [
    {"reason": "merch", "pattern": "\\bcharm\\b|\\btote\\b|\\bbag\\b|\\bpouch\\b|tumbler|sticker|sipper|\\bmug\\b"},
    {"reason": "lip product", "pattern": "lip balm|lip & cheek"}
  ],

